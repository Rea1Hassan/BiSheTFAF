        async function queryTrafficStatus() {
    const address = document.getElementById('address').value.trim();
    const diagonalDistance = document.getElementById('diagonalDistance').value;

    if (!address || !diagonalDistance) {
        alert('请填写完整的参数：地址和对角线距离');
        return;
    }

    const loadingElement = document.getElementById('loading');
    const errorMessageElement = document.getElementById('errorMessage');
    const trafficDataElement = document.getElementById('trafficData');

    loadingElement.style.display = 'block';
    errorMessageElement.style.display = 'none';
    trafficDataElement.style.display = 'none';

    try {
        // 调用后端接口获取地址的经纬度
        const locationResponse = await fetch('/get_location/', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRFToken': getCookie('csrftoken')
            },
            body: JSON.stringify({ address })
        });

        if (!locationResponse.ok) {
            throw new Error('无法获取地址的经纬度');
        }

        const locationData = await locationResponse.json();
        if (!locationData.location) {
            throw new Error(locationData.error || '无法找到该地址');
        }

        // 解析经纬度
        const lnglat = locationData.location.split(',').map(Number);

        // 将地图中心点移动到该地址
        map.setCenter(lnglat);

        // 发起交通态势查询请求
        const trafficResponse = await fetch('/calculate_rect_bounds_and_query/', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRFToken': getCookie('csrftoken')
            },
            body: JSON.stringify({ address, diagonal_distance: diagonalDistance })
        });

        if (!trafficResponse.ok) {
            throw new Error('网络响应失败');
        }

        const trafficData = await trafficResponse.json();

        if (trafficData.error) {
            throw new Error(trafficData.error);
        } else {
            // 更新以显示交通数据
            trafficDataElement.textContent = JSON.stringify(trafficData.data, null, 2);
            trafficDataElement.style.display = 'block';

            // 显示交通态势在地图上
            displayTrafficOnMap(trafficData.data);
        }
    } catch (error) {
        errorMessageElement.textContent = error.message;
        errorMessageElement.style.display = 'block';
    } finally {
        loadingElement.style.display = 'none';
    }
}


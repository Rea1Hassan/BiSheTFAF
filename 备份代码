<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="chrome=1">
    <meta name="viewport" content="initial-scale=1.0, user-scalable=no, width=device-width">
    <style type="text/css">
        body, html, #container {
            width: 100%;
            height: 100%;
            margin: 0px;
        }
        #addressForm {
            position: absolute;
            top: 10px;
            left: 10px;
            z-index: 1000;
        }
    </style>
    <title>地址搜索</title>
</head>
<body>
    <div id="addressForm">
        <input type="text" id="addressInput" placeholder="请输入地址"/>
        <button onclick="searchAddress()">搜索</button>
    </div>
    <div id="container" tabindex="0"></div>

    <!-- 加载高德地图API -->
    <script src="https://webapi.amap.com/maps?v=1.4.15&key=d0dba3c115e1f259143aee8eeb6e188b"></script>
    <script type="text/javascript">
        var map = new AMap.Map('container', {
            resizeEnable: true,
            center: [114.057939,22.543527],
            zoom: 11
        });

        // 添加工具栏插件
        AMap.plugin('AMap.ToolBar', function() {
            var toolbar = new AMap.ToolBar();
            map.addControl(toolbar);
        });

        function getCookie(name) {
            let cookieValue = null;
            if (document.cookie && document.cookie !== '') {
                const cookies = document.cookie.split(';');
                for (let i = 0; i < cookies.length; i++) {
                    const cookie = cookies[i].trim();
                    // Does this cookie string begin with the name we want?
                    if (cookie.substring(0, name.length + 1) === (name + '=')) {
                        cookieValue = decodeURIComponent(cookie.substring(name.length + 1));
                        break;
                    }
                }
            }
            return cookieValue;
        }

        function searchAddress() {
            var address = document.getElementById('addressInput').value;
            if (address) {
                fetch('/get_location/', {  // 注意这里的斜杠
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRFToken': getCookie('csrftoken')  // 添加CSRF令牌
                    },
                    body: JSON.stringify({address: address})
                })
                .then(response => response.json())
                .then(data => {
                    if (data && data.location) {
                        var lnglat = data.location.split(',');
                        map.setCenter([parseFloat(lnglat[0]), parseFloat(lnglat[1])]);
                        addMarker([parseFloat(lnglat[0]), parseFloat(lnglat[1])]);
                    } else {
                        alert('无法找到该地址');
                    }
                })
                .catch(error => console.error('Error:', error));
            } else {
                alert('请输入地址');
            }
        }

        function addMarker(lnglat) {
            var marker = new AMap.Marker({
                position: new AMap.LngLat(lnglat[0], lnglat[1]),
                title: '搜索位置'
            });
            map.add(marker);
        }
    </script>
</body>
</html>





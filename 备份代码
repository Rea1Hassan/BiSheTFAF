    map.remove(map.getAllOverlays('polyline'));

    // 定义颜色和粗细
    const styles = {
        '3': {color: 'red', weight: 8},    // 拥堵：最粗
        '2': {color: 'orange', weight: 6}, // 缓慢：次之
        '1': {color: 'green', weight: 4},  // 畅通：更细
        '0': {color: 'grey', weight: 2}    // 未知：最细
    };

    trafficData.name.forEach((roadName, index) => {
        if (trafficData.geometry[index] && trafficData.status[index] in styles) {
            const polyline = new AMap.Polyline({
                path: trafficData.geometry[index].map(point => [point[0], point[1]]),
                strokeColor: styles[trafficData.status[index]].color,
                strokeWeight: styles[trafficData.status[index]].weight,
                strokeOpacity: 0.8,
                zIndex: 50
            });
            map.add(polyline);
        }
    });

    const counts = {3:0, 2:0, 1:0, 0:0};
    trafficData.status.forEach(s => counts[s]++);

    document.getElementById('congestion-count').textContent = `${counts[3]}条`;
    document.getElementById('slow-count').textContent = `${counts[2]}条`;
    document.getElementById('smooth-count').textContent = `${counts[1]}条`;
    document.getElementById('unknown-count').textContent = `${counts[0]}条`;
}

    // 生成虚构新闻内容
        const newsData = [
            {
                tag: 'congestion',
                title: '早高峰提示',
                content: '建国路东向西方向车流量较大，建议提前绕行',
                time: '07:30'
            },
            {
                tag: 'construction',
                title: '道路施工通知',
                content: '朝阳北路（东四环至青年路段）夜间施工，23:00-05:00封闭',
                time: '昨日'
            },
            {
                tag: 'accident',
                title: '事故提醒',
                content: '北五环上清桥东侧发生交通事故，后方车辆注意避让',
                time: '09:15'
            }
        ];

        function generateNews() {
            const container = document.getElementById('news-container');
            container.innerHTML = newsData.map(item => `
                <div class="news-item">
                    <div class="news-tag tag-${item.tag}">${getTagName(item.tag)}</div>
                    <div class="news-content">
                        <div style="font-weight: 500; margin-bottom: 0.25rem;">${item.title}</div>
                        <div style="font-size: 0.9rem; color: #666;">${item.content}</div>
                    </div>
                    <div style="font-size: 0.8rem; color: #999;">${item.time}</div>
                </div>
            `).join('');
        }

        function getTagName(tag) {
            return {
                congestion: '拥堵提醒',
                accident: '事故通报',
                construction: '施工公告'
            }[tag] || '交通信息';
        }

        // 初始化新闻
        generateNews();
    </script>
